{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityfashion-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "cityfashion-orders",
      // Replaced with the real id after `wrangler d1 create cityfashion-orders`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Public, non-secret settings. Secrets (RESEND_API_KEY, ORDER_RATE_LIMIT_SALT)
  // are added with `npx wrangler secret put <NAME>` and never stored in this file.
  "vars": {
    "ADMIN_EMAIL": "sharukeshk.seker@gmail.com",
    "ORDER_NOTIFICATION_EMAIL": "sharukeshk.seker@gmail.com",
    "ORDER_EMAIL_FROM": "City Fashion Orders <orders@cityfashion.shop>",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "PAYMENT_INSTRUCTIONS": ""
  }
}
