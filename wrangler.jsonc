{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityfashion-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "cityfashion-orders",
      "database_id": "07cacc6e-2edf-461b-96c7-7318f8f8dd47",
      "migrations_dir": "migrations"
    }
  ],
  // Public, non-secret settings. Secrets (RESEND_API_KEY, ORDER_RATE_LIMIT_SALT)
  // are added with `npx wrangler secret put <NAME>` and never stored in this file.
  "vars": {
    "ADMIN_EMAIL": "sharukesh.seker@gmail.com",
    "ORDER_NOTIFICATION_EMAIL": "sharukesh.seker@gmail.com",
    "ORDER_EMAIL_FROM": "City Fashion Orders <onboarding@resend.dev>",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "PAYMENT_INSTRUCTIONS": ""
  }
}
